<Window x:Class="ViperAstmEmulator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:ViperAstmEmulator.Views"
        Title="Lab Interface Emulator - ASTM · HL7 v2 · FHIR" Height="900" Width="1450" MinWidth="1000" MinHeight="650"
        WindowStartupLocation="CenterScreen" FontSize="12">
    <TabControl x:Name="ProtocolTabs" Margin="4" Padding="0">
        <TabItem>
            <TabItem.Header>
                <TextBlock Text="ASTM  (BD Viper LT)" FontWeight="SemiBold" Margin="6,2" ToolTip="ASTM E1381 / E1394 over TCP or serial" />
            </TabItem.Header>
            <views:AstmView x:Name="Astm" />
        </TabItem>
        <TabItem>
            <TabItem.Header>
                <TextBlock Text="HL7 v2  /  FHIR" FontWeight="SemiBold" Margin="6,2" ToolTip="HL7 v2 over MLLP, FHIR R4 over HTTP (send and receive)" />
            </TabItem.Header>
            <views:Hl7View x:Name="Hl7" />
        </TabItem>
    </TabControl>
</Window>
